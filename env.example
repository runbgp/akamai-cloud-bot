# Discord bot token
DISCORD_TOKEN=your_discord_bot_token_here

# Akamai Cloud API token
AKAMAI_API_TOKEN=your_akamai_cloud_api_token_here

# Discord user IDs that can run `/admin-*` commands. Separate multiple IDs with commas.
ADMIN_USER_IDS=

# Automatic cleanup intervals. These values are the defaults.
NUDGE_INTERVAL_DAYS=7
NUDGE_GRACE_DAYS=2
NUDGE_REMINDER_DAYS=1
NUDGE_CHECK_HOURS=1

# The refresh task synchronizes tracked instances from Linode at this interval.
# `/list-instances` always refreshes immediately.
REFRESH_INTERVAL_MINUTES=10

# The maximum instance age, in days. A value of `0` disables this limit.
MAX_LIFETIME_DAYS=0
