# Discord Bot Token
DISCORD_TOKEN=your_discord_bot_token_here

# Akamai Cloud API Token
AKAMAI_API_TOKEN=your_akamai_cloud_api_token_here

# Comma-separated Discord user IDs allowed to run /admin-* commands
ADMIN_USER_IDS=

# Auto-cleanup nudge tuning (defaults shown)
NUDGE_INTERVAL_DAYS=7
NUDGE_GRACE_DAYS=2
NUDGE_REMINDER_DAYS=1
NUDGE_CHECK_HOURS=1

# How often the background loop resyncs every tracked instance from Linode.
# /list-instances refreshes inline regardless, so this is just a backstop.
REFRESH_INTERVAL_MINUTES=10

# Optional hard cap on instance lifetime regardless of confirmations.
# 0 disables the cap.
MAX_LIFETIME_DAYS=0